# Cabeçalhos HTTP (lidos automaticamente pelo Cloudflare Pages)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN

# Frames da animação: guardados no navegador por 30 dias.
# Ao substituir os frames, aumente "version" em script.js (CONFIG.frames.version).
/frames/*
  Cache-Control: public, max-age=2592000

# Fotos e ícones: 7 dias
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Catálogo inicial (o site usa a versão ao vivo da API; esta é a reserva)
/data/*
  Cache-Control: no-cache

# App do lojista: sem cache longo (pega atualizações na hora), fora do Google
# e só carrega arquivos do próprio site.
/admin/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'
